{
  "name": "@souqstudio/db",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "credits:grant": "tsx --env-file-if-exists=.env scripts/grant-credits.ts",
    "catalog:import-off": "tsx scripts/import-off.ts",
    "catalog:import-unioncoop": "tsx scripts/import-unioncoop.ts",
    "catalog:seed-demo": "tsx scripts/seed-catalog-demo.ts",
    "catalog:harness-export": "tsx scripts/export-harness-products.ts",
    "blocks:convert-logo": "tsx --env-file-if-exists=../../apps/web/.env.local scripts/convert-logo-elements.ts",
    "admin:create": "tsx --env-file-if-exists=.env scripts/create-admin.ts"
  },
  "dependencies": {
    "@souqstudio/types": "workspace:*",
    "@prisma/client": "^5.0.0",
    "bullmq": "^5.0.0",
    "ioredis": "^5.0.0",
    "@souqstudio/engine": "workspace:*",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "@souqstudio/config": "workspace:*",
    "prisma": "^5.0.0",
    "typescript": "^5.0.0",
    "tsx": "^4.0.0",
    "vitest": "^2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
