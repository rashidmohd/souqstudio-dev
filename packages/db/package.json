  },
  "devDependencies": {
    "@souqstudio/config": "workspace:*",
    "prisma": "^5.0.0",
    "typescript": "^5.0.0",
    "tsx": "^4.0.0",
    "vitest": "^2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
