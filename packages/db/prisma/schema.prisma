generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Billing entity ───────────────────────────────────────────────────────────
model Organization {
  id                   String  @id @default(cuid())
  name                 String
  email                String
  vatNumber            String?
  country              String  @default("AE")
  timezone             String  @default("Asia/Dubai")
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  planId               String?
  billingStatus        String  @default("active") // active | past_due | suspended | cancelled

  /// E1-03: the owner can require two-factor authentication for everyone in the
  /// organization. Enforced as a redirect to enrollment, never as a refusal to
  /// sign in — the worst case must be "everyone has to enroll", not "nobody can
  /// get in". See apps/web/lib/two-factor.ts.
  requireTwoFactor      Boolean   @default(false)
  /// When the policy was last turned on. Carried so the UI can say "required
  /// since 3 March", and so a grace period can be added later without a second
  /// schema change. Null whenever requireTwoFactor is false.
  requireTwoFactorSince DateTime?

  /// E2-01. The organization's logo, and the default every shop inherits
  /// unless its brandOverride says otherwise. Stored at `{orgId}/org/logo.png`
  /// in R2 — see orgAssetKey() in apps/web/lib/r2.ts.
  logoUrl  String?
  /// E2-05. Organization-level brand defaults — the kit every shop inherits
  /// from. Same shape as shops.brandKit:
  /// `BrandKit` from @souqstudio/types: palette, textStyles, the four font
  /// slots and logo status. Identity only — it holds no layout. A brand kit
  /// has many blocks; it does not contain a choice of one, and which grid a
  /// book uses is a decision about that book. See docs/composition-model.md §2.
  /// A shop resolves its effective kit from this plus its own, according to
  /// shops.brandOverride. See apps/web/lib/brand-inheritance.ts.
  brandKit Json?

  /// E3-01. Everything below is a *cache of Stripe*, written only by the webhook
  /// handler in app/api/v1/webhooks/stripe. Stripe stays authoritative — these
  /// exist so the billing screen can render the next billing date without a
  /// round trip on every page load, and so a webhook outage is visible as stale
  /// data rather than as a wrong charge. Never compute money from them.
  currentPeriodEnd  DateTime?
  /// True between "cancel" and the end of the paid period. Access continues.
  cancelAtPeriodEnd Boolean   @default(false)
  /// E3-01 downgrade. Set when a lower plan is scheduled for the period end;
  /// cleared when it applies. An upgrade is immediate and never lands here.
  pendingPlanId     String?
  /// E3-04 failed payments. When the subscription first went past_due — the
  /// clock the seven-day grace period is measured from. Cleared on recovery.
  pastDueSince      DateTime?
  /// E3-01 cancellation. Ninety days after the paid period ended, at which
  /// point the data is purged. Carried so the warning can name the date.
  dataPurgeAt       DateTime?
  /// E3-03. `pooled` — every shop draws on the organization balance.
  /// `allocated` — each shop is capped by its ShopCreditAllocation row.
  /// Business plan and above; the plan check lives in lib/plans.ts.
  creditPooling     String    @default("pooled") // pooled | allocated

  plan                  Plan?                  @relation("OrganizationPlan", fields: [planId], references: [id])
  pendingPlan           Plan?                  @relation("OrganizationPendingPlan", fields: [pendingPlanId], references: [id])
  shops                 Shop[]
  users                 User[]
  userShopAccess        UserShopAccess[]
  invites               Invite[]
  usageEvents           UsageEvent[]
  aiJobs                AiJob[]
  creditBalance         CreditBalance?
  creditTopups          CreditTopup[]
  shopCreditAllocations ShopCreditAllocation[]
  catalogProducts       CatalogProduct[]
  catalogImports        CatalogImport[]
  captureSessions       CaptureSession[]
  bookDrafts            OfferBookDraft[]
  promoTiers            PromoTier[]
  /// Blocks this organization authored. A seeded block has no organization.
  blocks                Block[]
  blockAssets           BlockAsset[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@map("organizations")
}

// ─── Operational unit ─────────────────────────────────────────────────────────
model Shop {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  location       String?
  phone          String?
  logoUrl        String?
  /// `BrandKit` from @souqstudio/types: palette, textStyles, the four font
  /// slots and logo status. Identity only — it holds no layout. A brand kit
  /// has many blocks; it does not contain a choice of one, and which grid a
  /// book uses is a decision about that book. See docs/composition-model.md §2.
  brandKit       Json?
  brandOverride  String  @default("inherit") // inherit | logo | colors | full
  isActive       Boolean @default(true)

  /// E8-01. What the shop sells, from `SHOP_TRADES` in @souqstudio/engine —
  /// grocery | electronics | pharmacy | butcher | bakery | restaurant |
  /// fashion | hardware | beauty | other. Up to `MAX_TRADES` of them, in the
  /// owner's own order; the first is what the shop leads with.
  ///
  /// **A list, because shops are.** A grocery with a bakery counter is the
  /// common case in this market rather than an edge one, and forcing it to pick
  /// one produces a character holding the wrong thing.
  ///
  /// **Closed, and it steers a prompt.** A generated character for a butcher is
  /// not a character for an electronics shop, and this is what tells them apart.
  /// A free-text trade would be an unbounded string reaching a model prompt,
  /// which is both an injection surface and a vocabulary nothing can be tested
  /// against. The shop's own words go in `bio`, which is quoted rather than
  /// interpolated as an instruction.
  ///
  /// A scalar list rather than JSONB: it is a set of short enum-shaped strings
  /// with no structure to it, and `String[]` is queryable where a JSON array is
  /// not. `storePhotoKeys` beside it stays JSONB because it may grow fields.
  trades         String[]
  /// E8-01. A few sentences the owner writes about the shop. Optional detail on
  /// top of `trade`, never a substitute for it.
  bio            String?
  /// E8-01. R2 object keys of photographs of the shop itself, as a JSON array of
  /// strings. Used as scene references when an owner wants their character shown
  /// inside their own shop. Keys rather than URLs, so this survives the bucket
  /// moving behind a different public origin.
  storePhotoKeys Json?
  covers         Cover[]

  /// E2-02. Null while active. A deactivated shop keeps all of its data and
  /// stops generating content. Paired with isActive rather than replacing it:
  /// the boolean is what every query filters on, the timestamp is what the
  /// screen and the billing seam need.
  deactivatedAt            DateTime?
  /// E2-02 "remove shop". Soft, always. Offer books and analytics are retained
  /// and archived — a published book references this shop and must not break.
  /// There is no code path that deletes a shop row.
  archivedAt               DateTime?
  /// E3 owns this column and is its only writer. Each shop above the base plan
  /// is a Stripe subscription item. Carried here so that adding a shop does not
  /// need a second migration once billing lands.
  stripeSubscriptionItemId String?   @unique

  organization     Organization          @relation(fields: [organizationId], references: [id])
  userAccess       UserShopAccess[]
  offerBooks       OfferBook[]
  characters       Character[]
  socialConns      SocialConnection[]
  creditAllocation ShopCreditAllocation?
  offerOverrides   OfferShopOverride[]
  captureSessions  CaptureSession[]
  bookDrafts       OfferBookDraft[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([organizationId])
  @@index([organizationId, archivedAt])
  @@map("shops")
}

// ─── Users ────────────────────────────────────────────────────────────────────
model User {
  id             String  @id @default(cuid())
  organizationId String
  email          String  @unique
  passwordHash   String?
  name           String?
  role           String // owner | manager | editor | viewer

  // Email verification. Null means unverified — E1 gates the editor on this,
  // so it is a timestamp rather than a boolean: "when" is needed for support.
  emailVerifiedAt DateTime?

  // Failed-login lockout. E1-02: five attempts, fifteen minute cooldown.
  // The counter resets to zero on any successful login.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  // Bumped to invalidate every outstanding session for this user at once —
  // password change, 2FA reset, or an owner revoking access. Cheaper than
  // deleting session rows and it cannot miss one.
  tokenVersion Int @default(0)

  twoFactorEnabled      Boolean   @default(false)
  /// TOTP shared secret, sealed by apps/web/lib/two-factor-secret.ts. Read and
  /// written only through that module — the stored form carries a version tag
  /// ("v0:…"), so it is not a bare base32 secret and must not be handed to
  /// otplib directly. Currently v0 = plaintext; encrypting it is the open
  /// question in souqstudio-technical → references/auth.md, tied to the E10
  /// key-management decision.
  twoFactorSecret       String?
  /// When two-factor was last switched on, for the account-security screen.
  twoFactorEnabledAt    DateTime?
  /// RFC 6238 time step of the last accepted code. A code stays valid for up to
  /// 90 seconds across the drift window, so without this a code observed over a
  /// shoulder or through a phishing proxy can be replayed into a *fresh*
  /// challenge — which the single-use challenge row does not prevent, because
  /// the attacker starts their own. Advanced by compare-and-set, never blindly.
  twoFactorLastTimeStep Int?

  /// E1-05: when this person dismissed the getting-started checklist.
  ///
  /// Per-user rather than per-shop, even though the items it tracks are shop
  /// and org progress. Dismissal is a statement about what one person wants on
  /// their screen; a manager hiding it should not hide it from the owner.
  checklistDismissedAt DateTime?

  /// E2-03. Set when an owner removes someone from the organization. The row
  /// is kept rather than deleted: sessions, offer books and any future audit
  /// trail reference it, and a hard delete would have to cascade through five
  /// tables to succeed. getSession() treats a removed user as no session.
  removedAt DateTime?

  organization         Organization             @relation(fields: [organizationId], references: [id])
  shopAccess           UserShopAccess[]
  grantsGiven          UserShopAccess[]         @relation("GrantedBy")
  invitesSent          Invite[]                 @relation("InvitesSent")
  notifications        Notification[]
  notifPrefs           NotificationPreference[]
  sessions             Session[]
  backupCodes          TwoFactorBackupCode[]
  twoFactorChallenges  TwoFactorChallenge[]
  twoFactorEnrollments TwoFactorEnrollment[]
  bookDrafts           OfferBookDraft[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([organizationId])
  @@index([organizationId, removedAt])
  @@map("users")
}

/// E2-04. Which shops a person can act on, and with what role.
///
/// The owner is deliberately absent from this table: E2-04 says the owner sees
/// every shop automatically, so an owner needs no grant row and one is never
/// written. Everyone else reaches exactly the shops listed here — an org-level
/// role with no grant row reaches nothing.
model UserShopAccess {
  userId         String
  shopId         String
  /// Denormalized from the shop. Required by the RLS policy — a tenant table
  /// with no organizationId has nothing for the policy to compare against —
  /// and it turns "every grant in this organization" into one indexed read
  /// rather than a join through shops.
  organizationId String
  role           String? // overrides the org-level role for this shop if set
  /// Who granted it. Access changes are the one thing in this epic somebody
  /// will later want explained, and there is no org-facing audit log yet.
  grantedById    String?

  user         User         @relation(fields: [userId], references: [id])
  shop         Shop         @relation(fields: [shopId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  grantedBy    User?        @relation("GrantedBy", fields: [grantedById], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@id([userId, shopId])
  @@index([shopId])
  @@index([organizationId])
  @@map("user_shop_access")
}

/// E2-03. A pending team member.
///
/// A dedicated table rather than a third VerificationToken type. That model is
/// a deliberate two-secret design — a six-digit code in the inbox plus a
/// 32-byte token in an httpOnly cookie — which is right for proving control of
/// an address from the browser that asked for it, and wrong for a link that
/// gets forwarded and opened on a phone that has never seen this product. An
/// invite carries one secret: the token in the URL. It also carries state
/// VerificationToken has nowhere to put — the role, the shop grants, and who
/// sent it.
///
/// Accepting an invite sets emailVerifiedAt: following the link *is* proof of
/// address control, so asking for a second code afterwards would be theatre.
model Invite {
  id             String @id @default(cuid())
  organizationId String
  email          String
  /// manager | editor | viewer. Never owner — there is exactly one path to
  /// owner and it is signup.
  role           String
  /// sha256 of the token. The raw token exists only in the emailed link.
  tokenHash      String @unique

  invitedById String
  /// Shops granted on acceptance, with an optional per-shop role override:
  /// [{ shopId: string, role?: 'manager' | 'editor' | 'viewer' }]
  /// E2-04 allows the same person a different role in each shop, so this
  /// cannot collapse to a list of ids.
  shopGrants  Json?

  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  /// Drives the escalating resend cooldown, the same shape as the one in
  /// apps/web/lib/verification.ts.
  resendCount Int       @default(0)
  lastSentAt  DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  invitedBy    User         @relation("InvitesSent", fields: [invitedById], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  /// One live invite per address per organization. Re-inviting rotates the
  /// token and resets the clock on the existing row — which is exactly what
  /// "resend expired invite" means, so both are one code path.
  @@unique([organizationId, email])
  @@index([organizationId, acceptedAt])
  @@index([expiresAt])
  @@map("invites")
}

/// Database-backed sessions, so they can be revoked server-side. E1 requires
/// revocability, which a stateless JWT cannot give.
///
/// The raw session token is never stored. Only a SHA-256 hash of it lands here,
/// so a leaked dump of this table cannot be replayed as a login. Look rows up by
/// hashing the incoming cookie and matching `tokenHash`.
///
/// Not RLS-gated on organizationId: this table is read *before* the org context
/// exists — reading it is how the org is discovered. Isolation comes from the
/// token being unguessable, not from a row policy.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // SHA-256 of the session token. Never the token itself.
  expiresAt DateTime

  // Rotation family. Every refresh issues a new row carrying the same familyId
  // and points the old row at it via replacedById. If a token that was already
  // replaced is presented again, it was stolen — revoke the whole family.
  familyId     String
  replacedById String?   @unique
  revokedAt    DateTime?

  // Audit trail for the account-security screen: "last used, from where".
  // The IP is hashed — it is a personal identifier under GDPR and the UAE PDPL,
  // and comparing sessions never needs the original value.
  lastUsedAt DateTime?
  ipHash     String?
  userAgent  String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt]) // supports the expired-session sweep
  @@map("sessions")
}

/// Email verification and password reset. E1-01 and E1-02.
///
/// One table for both, discriminated by `type`, because the lifecycle is
/// identical: issue, email a code, consume once, expire.
///
/// **Two secrets, and both are required.** The OTP is the six digits in the
/// email. The token is a 32-byte handle held in an httpOnly cookie, naming which
/// verification attempt is in progress. Presenting one without the other proves
/// nothing:
///
///   tokenHash = sha256(token)              — the lookup key
///   otpHash   = sha256(token + ':' + otp)  — binds the code to that token
///
/// So a code emailed to one person cannot be redeemed from a browser that never
/// requested it, and a database dump yields neither secret — the raw token is
/// never stored, so `otpHash` cannot be ground down against six digits.
///
/// That is also why the OTP is not bcrypted. A 10^6 space falls to any KDF
/// eventually; the real defense is the attacker needing a 32-byte token they do
/// not have, plus `attempts` and a short expiry.
model VerificationToken {
  id         String @id @default(cuid())
  identifier String // email address the code was issued to
  tokenHash  String @unique // sha256(token)
  otpHash    String // sha256(token + ':' + otp) — useless without the token
  type       String // email_verification | password_reset

  /// Wrong codes so far. At the cap the row is consumed and a fresh code must be
  /// requested; without it six digits is a few hundred thousand guesses.
  attempts Int @default(0)

  /// How many times a code has been re-sent to this address in this run,
  /// carried forward each reissue. Drives the escalating cooldown — 1, 3, 10
  /// then 60 minutes — so a resend button cannot be used to mail-bomb someone.
  /// Resets naturally when a run completes, because the next run starts at zero.
  resendCount Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime? // single-use: set on redemption and on attempt burnout
  createdAt   DateTime  @default(now())

  @@index([identifier, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

/// Delivery log for every email the worker sends. Required by
/// apps/worker/CLAUDE.md → Email worker rules.
///
/// Operational, not tenant data: the questions it answers are "did the
/// verification code actually go out" and "is Resend rejecting us", asked by
/// support and by whoever is on call. Not RLS-gated for that reason.
///
/// **Never log `props`.** They carry one-time codes and reset links; a delivery
/// log is the wrong place for a live credential.
model NotificationLog {
  id         String    @id @default(cuid())
  template   String // matches EmailTemplate in @souqstudio/types
  recipient  String
  status     String // queued | sent | failed
  providerId String? // Resend message id, for correlating with their dashboard
  error      String? // provider message on failure — never a stack trace
  attempts   Int       @default(1)
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([recipient])
  @@index([status, createdAt])
  @@map("notification_log")
}

/// The half-authenticated state between a correct password and a correct second
/// factor. E1-03.
///
/// Deliberately **not** a flag on `sessions`. A row in that table means "this
/// request is authenticated", and giving it a second meaning fails open: every
/// future reader — revokeAllSessions, the device list, E13 impersonation — would
/// have to remember the flag, and one that forgets is an authentication bypass.
/// A pending row would also sail past middleware's cookie-presence check and
/// then be rejected by requireSession(), losing the `next` param that middleware
/// exists to preserve.
///
/// Carries the login intent captured at the password step — rememberMe, ipHash,
/// userAgent — so issueSession() receives exactly what it would have received
/// had there been no second factor.
///
/// Not RLS-gated, for the same reason `sessions` is not: read during login,
/// before any org context exists. Isolation comes from the token being
/// unguessable.
model TwoFactorChallenge {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // sha256 of the sq_2fa cookie value. Never the token.
  expiresAt DateTime

  /// Wrong codes so far. At the cap the row is consumed and a fresh password
  /// login is required. The per-challenge cap alone is not the real bound —
  /// wrong codes also count toward users.failedLoginAttempts, or an attacker
  /// holding the password could mint unlimited challenges at five guesses each.
  attempts   Int       @default(0)
  consumedAt DateTime? // single-use: claimed by compare-and-set, never re-read

  // Login intent, carried forward from the password step.
  rememberMe Boolean @default(false)
  ipHash     String?
  userAgent  String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("two_factor_challenges")
}

/// A TOTP secret that has been shown to someone but not yet proven. E1-03.
///
/// Kept off `users` so an abandoned enrollment leaves nothing behind. Were the
/// unconfirmed secret written to users.twoFactorSecret, the `twoFactorEnabled`
/// boolean would be the only thing standing between a half-finished setup and a
/// live credential, and any later code that reads the secret without checking
/// the boolean would be a silent bug.
///
/// A separate table from TwoFactorChallenge rather than one table with a `type`
/// discriminator, even though VerificationToken sets that precedent. There the
/// two types are the same machine differing only in what the caller does after.
/// Here they are not, and type confusion between them is an authentication
/// bypass: an enrollment row consumed as a login challenge issues a session.
model TwoFactorEnrollment {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // sha256 of the sq_2fa_enroll cookie value
  /// Sealed by apps/web/lib/two-factor-secret.ts, same as users.twoFactorSecret.
  secret    String
  expiresAt DateTime

  attempts   Int       @default(0)
  consumedAt DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("two_factor_enrollments")
}

/// Single-use recovery codes for TOTP 2FA. E1-03: generated at setup, shown
/// once, downloadable.
///
/// Hashed, because they are password-equivalent — each one is a complete
/// bypass of the second factor.
///
/// The hash is sha256 peppered with the userId, not bcrypt, and `codeHash`
/// being `@unique` is why. bcrypt salts per hash, so a submitted code could not
/// be looked up — verification would mean loading every unused row and running
/// a comparison against each, which is ~2.5 seconds on the login path and a 10x
/// CPU amplifier on an endpoint reachable with the password alone. These are
/// 60-bit CSPRNG strings used once, so there is no dictionary for a slow KDF to
/// defend against; the same argument lib/tokens.ts makes for session tokens.
/// The userId pepper is what stops a stolen dump being attacked in bulk.
model TwoFactorBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime? // single-use; a used code is kept as an audit record
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("two_factor_backup_codes")
}

// ─── Plans ────────────────────────────────────────────────────────────────────
/// Global reference data, seeded and RLS-exempt. Ids are hand-written
/// (`plan_starter`, not a cuid) so the seed is idempotent and so code can name a
/// tier without a lookup — same reasoning as the grids and templates.
model Plan {
  id             String  @id
  name           String // Starter | Pro | Business | Enterprise
  maxShops       Int? // null = unlimited
  maxUsers       Int?
  aiCreditsMonth Int
  basePrice      Decimal
  pricePerShop   Decimal @default(0)

  /// Sort order, and the only definition of "up" and "down". A plan change is
  /// an upgrade when the target tier is higher — that is what decides whether
  /// it applies now with proration or at the end of the period (E3-01).
  tier               Int
  /// E3-03. Whether unused monthly credits survive the reset. Starter does not
  /// roll over; Pro and above carry up to CREDIT_ROLLOVER_MULTIPLE of the
  /// monthly allocation. See apps/web/lib/credits.ts.
  creditsRollover    Boolean @default(false)
  /// Stripe Price for the base subscription. Null on a plan that is not
  /// self-serve — Enterprise is a conversation, not a checkout button.
  stripePriceId      String? @unique
  /// Stripe Price for one shop above the included count, billed as a second
  /// subscription item with a quantity (E3-02). Null when the plan has no
  /// per-shop overage.
  stripeShopPriceId  String? @unique
  /// Whether the plan appears in the comparison table. An Enterprise or legacy
  /// plan stays assignable while being unlisted.
  isPublic           Boolean @default(true)
  /// How many products one offer book may carry. A plan limit rather than an
  /// architectural one: the real cost of 100 versus 400 is export duration and
  /// how many pages stay live in Fabric, neither of which is a design problem.
  /// Raising it is a row change. See docs/composition-model.md §7.
  maxProductsPerBook Int     @default(100)

  /// Feature flags JSON. Shape: { allocatedCredits, prioritySupport,
  /// customTemplates, apiAccess, whiteLabel } — all booleans, all optional.
  /// Read through lib/plans.ts, never indexed into directly.
  features             Json
  organizations        Organization[] @relation("OrganizationPlan")
  pendingOrganizations Organization[] @relation("OrganizationPendingPlan")

  @@map("plans")
}

// ─── Credits — E3-03 ──────────────────────────────────────────────────────────
/// The organization's AI credit balance. One row per organization.
///
/// This is the one part of billing that is *not* a cache of Stripe. Stripe
/// meters what was consumed; it does not hold an entitlement balance with
/// rollover rules and non-expiring top-ups on top. That arithmetic is ours, so
/// the balance is ours, and it is a row rather than a derived sum because every
/// AI action reads it on a latency budget.
model CreditBalance {
  organizationId String @id

  /// Credits from the monthly allocation, plus whatever rolled over. Reset on
  /// the billing cycle date. Spent before topupRemaining, so the credits that
  /// expire are used first.
  monthlyRemaining Int @default(0)
  /// Purchased credits (E3-03 top-up). Never expire, never reset.
  topupRemaining   Int @default(0)

  /// The allocation period, copied from the Stripe billing cycle. `periodEnd`
  /// in the past means the reset is due — it happens lazily on the next read
  /// as well as on the invoice.paid webhook, so a missed webhook delays credits
  /// rather than losing them.
  periodStart DateTime
  periodEnd   DateTime

  /// When the low-balance email last went out, so it goes out once per period
  /// rather than on every generation that crosses the threshold.
  lowBalanceNotifiedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("credit_balances")
}

/// A credit purchase (E3-03). Written pending before the charge, moved to
/// succeeded by the `invoice.paid` webhook — which is also what grants the
/// credits, so a duplicate delivery cannot grant twice.
model CreditTopup {
  id             String  @id @default(cuid())
  organizationId String
  credits        Int
  /// What was charged, in `currency`. Kept for the history list; the invoice in
  /// Stripe remains the authority.
  amount         Decimal
  currency       String  @default("usd")
  status         String  @default("pending") // pending | succeeded | failed

  /// The Stripe invoice raised for this purchase. Unique, and the idempotency
  /// key the webhook matches on.
  stripeInvoiceId String? @unique

  organization Organization @relation(fields: [organizationId], references: [id])
  createdAt    DateTime     @default(now())
  grantedAt    DateTime?

  @@index([organizationId, createdAt])
  @@map("credit_topups")
}

/// E3-03 allocated pooling, Business plan and above. A per-shop ceiling on the
/// organization balance — not a separate wallet. A shop with an allocation of
/// 200 may spend 200 credits this period *if the organization still has them*.
model ShopCreditAllocation {
  id             String @id @default(cuid())
  organizationId String
  shopId         String @unique
  /// Credits this shop may spend per period. Zero means the shop cannot
  /// generate; there is deliberately no null-means-unlimited case, because a
  /// missing row is already how "not capped" is expressed.
  allocated      Int

  organization Organization @relation(fields: [organizationId], references: [id])
  shop         Shop         @relation(fields: [shopId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([organizationId])
  @@map("shop_credit_allocations")
}

/// Every Stripe event we have seen, by Stripe's own id. Stripe retries and
/// duplicate delivery is normal, so the handler claims the row first and does
/// the work second. RLS-exempt: the webhook has no session and no org context
/// until it has parsed the event.
model StripeEvent {
  id          String    @id
  type        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  /// Set when the handler threw. The row stays so a retry is recognised as a
  /// retry, and `processedAt` stays null so the retry actually reprocesses.
  error       String?

  @@index([type, receivedAt])
  @@map("stripe_events")
}

// ─── Product catalog ──────────────────────────────────────────────────────────
//
// One table, two collections. `organizationId` null is the universal SouqStudio
// catalog; set, it is that organization's own upload. Two tables was the obvious
// alternative and is worse: one tsvector index covers both, precedence is an
// `ORDER BY` rather than a merge in application code, and `OfferItem` keeps a
// single foreign key instead of a polymorphic reference.
//
// Enums start here. Nothing above this line uses one — the rest of the schema
// spells closed sets as `String // a | b | c` — and that is deliberate rather
// than forgotten. The layout engine branches on every value below, and a bad
// string reaching it renders a card wrong on a printed page instead of throwing.
// Do not convert the older columns to match; a half-converted schema is worse
// than either convention held consistently.

enum PackUnit {
  G
  KG
  ML
  L
  PIECE
}

/// How a product is sold, as distinct from how it is measured.
///
/// **`packUnit` says what the number means; this says what the number is.** A
/// 500 g bag of rice and loose tomatoes at 4.50 a kilo both carry `KG`-family
/// units, and until this existed the second could only be described as a pack
/// of something — which made `deriveUnitPrice` divide a rate by a quantity that
/// was never there, and `packLabel` print a pack line for a product that has no
/// pack.
///
/// `PACK` is the default and the overwhelming case: a barcoded unit with a size
/// printed on it. `LOOSE` is anything weighed or measured at the counter, where
/// **the price already is the unit price** — so `packSize` and `packCount` are
/// meaningless on those rows and `packUnit` alone says what the price is per.
enum SellBy {
  PACK
  LOOSE
}

/// A product brand — Almarai, Tide, Anker. E5, "Catalog Sources".
///
/// **A table rather than the free-text columns it replaces, because a string
/// cannot carry a logo.** E5's render contract has item 0 supplying "the brand
/// lockup", and a lockup is a mark. The Catalog Sources table budgets for the
/// top 200 UAE brands under direct permission, which needs somewhere to put
/// them.
///
/// The other three things a string could not do: a brand filter, EN and AR
/// paired once instead of retyped on every product, and deduplication — the
/// Open Food Facts export writes `Almarai`, `almarai`, `AL MARAI` and
/// `Almarai®` as four different values.
///
/// **`catalog_products.brandEn`/`brandAr` stay.** They are the fallback when
/// `brandId` is null, which is what lets an owner type a brand nobody has ever
/// entered and still save the product. E5's rule is that nothing blocks a shop
/// adding a product; a required foreign key here would break it.
model ProductBrand {
  id String @id @default(cuid())

  /// The dedup key: lowercased, trademark marks and punctuation stripped,
  /// accents folded, whitespace collapsed. `brandSlug()` in
  /// `packages/types/src/brand-slug.ts` is the only thing that may compute it —
  /// three callers need the same answer and a second copy would eventually
  /// disagree, producing two rows for one brand.
  slug   String  @unique
  nameEn String
  nameAr String?

  /// An R2 key, never a remote URL — the same rule `image_assets` follows.
  /// Null until a permissioned asset exists, and the card falls back to the
  /// brand name, which is what it renders today.
  logoKey    String?
  /// Where that logo came from. E5: "images come from licensed sources or
  /// direct brand permission only." A logo is both an image and a trademark,
  /// so provenance is a column rather than something nobody recorded.
  /// brand_portal | licensed | shop_upload
  logoSource String?

  /// `unreviewed` is anything ingest or a shop owner created. `canonical` is a
  /// brand an admin has confirmed — name, Arabic, logo. Review decides
  /// promotion, not availability: an unreviewed brand is usable immediately,
  /// exactly as `product_contributions` works for products.
  status     String    @default("unreviewed")
  reviewedAt DateTime?

  products  CatalogProduct[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([status])
  /// Declared here as well as in the migration on purpose. A model that does
  /// not mention an index makes `db push` and `migrate dev` generate a DROP for
  /// it, and losing this one reads as slow suggestions rather than as a missing
  /// index — the same lesson `search_vector` taught.
  @@index([nameEn(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_product_brands_trgm")
  @@map("product_brands")
}

model CatalogProduct {
  id             String  @id @default(cuid())
  /// Null = universal catalog, visible to every organization. Set = private to
  /// that organization, and the only rows a shop owner can edit. Precedence at
  /// search time is org rows first, universal as fallback.
  organizationId String?

  /// EN and AR are both v1 surfaces, so they are paired columns rather than a
  /// translation side table. `nameAr` is nullable at ingest and **required
  /// before an offer using this product publishes to an AR edition** — a
  /// completeness warning in the catalog, never a hard block at import, or
  /// import throughput dies.
  nameEn   String
  nameAr   String?
  /// Free text, and the fallback whenever `brandId` is null. Kept rather than
  /// replaced: an owner typing a brand the catalog has never seen must still be
  /// able to save the product.
  brandEn  String?
  brandAr  String?
  /// The resolved brand, when the string matched or created one. Nullable by
  /// design — see `ProductBrand`.
  brandId  String?
  /// The variant line under the name: "versch. Sorten, je 200-g-Becher".
  specEn   String?
  specAr   String?
  /// Rendered as a prefix line above the name, not folded into spec — except
  /// at DENSE density, where E6 §5 folds it in.
  originEn String?
  originAr String?

  category    String?
  subcategory String?

  /// Pack maths for the derived unit price (E5 §5). `packSize` is in `packUnit`;
  /// `packCount` is the multiplier on a multipack — 8 × 25 g is size 25, unit G,
  /// count 8. All three null means no unit price can be derived, and the offer
  /// falls back to `unitPriceMode = HIDDEN`.
  packSize  Decimal?  @db.Decimal(10, 3)
  packUnit  PackUnit?
  packCount Int?

  /// Whether the three columns above describe a pack or a counter price. See
  /// `SellBy`. Defaulted rather than nullable: every row that existed before
  /// this column is a pack, and a null would make every reader decide what
  /// absence meant.
  sellBy    SellBy    @default(PACK)

  /// The shop's own item code, as their till and their price list spell it.
  ///
  /// **A barcode is the world's identity for a product; this is the shop's.**
  /// They are not interchangeable and one cannot stand in for the other: an
  /// own-brand line and a loose vegetable have an item code and no barcode at
  /// all, and two shops may legitimately use the same code for different
  /// things. Import matches on this *before* barcode — within one organization
  /// it is the more authoritative of the two, because it is the key the owner's
  /// own sheet is written against.
  ///
  /// Meaningless on a universal row, which belongs to no shop; the compound
  /// unique below is what confines it to a collection, exactly as `barcode`
  /// does. Nothing requires it — E5's rule that nothing blocks a shop adding a
  /// product applies here as much as to `brandId`.
  sku      String?
  /// Who the shop buys it from. Free text, and deliberately not a table.
  ///
  /// `ProductBrand` earned a table because a string cannot carry a logo and a
  /// brand lockup renders on the card. A supplier renders nowhere, has no
  /// asset, and is not shared between organizations — so the three things that
  /// justified the brand table are all absent, and a string that can later be
  /// backfilled into a table is the cheaper order to do this in.
  supplier String?

  /// Not globally unique any more. An organization may hold its own row for a
  /// barcode the universal catalog also has — that is the whole point of the
  /// private collection. Uniqueness is per collection: the compound index
  /// below for org rows, and a partial unique index in the migration for the
  /// universal ones, because Postgres treats NULLs as distinct.
  barcode    String?
  tags       String[]
  /// Extra attributes (nutritional data, dimensions, etc.)
  metadata   Json?
  source     String? // open_food_facts | gtin | user_contribution | manual | import
  /// Set when the enrich worker last generated synonyms and translations.
  enrichedAt DateTime?
  /// Catalog products are archived, never deleted — a published offer book
  /// references this row and must not break. See references/database.md.
  archivedAt DateTime?

  organization  Organization?         @relation(fields: [organizationId], references: [id])
  brand         ProductBrand?         @relation(fields: [brandId], references: [id])
  images        ImageAsset[]
  synonyms      ProductSynonym[]
  contributions ProductContribution[]
  offerItems    OfferItem[]
  importRows    CatalogImportRow[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  /// Trigger-maintained by the E5 migration — nameEn and nameAr at weight A,
  /// brand and category at B, spec and tags at C, `simple` dictionary. Prisma
  /// cannot express the column's type, the GIN index or the trigger, so all
  /// three are raw SQL. It is declared here as Unsupported anyway: a model that
  /// does not mention the column makes `prisma db push` and `migrate dev`
  /// generate a DROP for it, and losing the search index would look like slow
  /// search rather than like a missing index. An Unsupported field is excluded
  /// from the generated client automatically, so it can only be queried raw.
  searchVector Unsupported("tsvector")? @map("search_vector")

  @@unique([organizationId, barcode])
  /// Same shape and same reasoning as the barcode pair above: one item code per
  /// collection, and NULLs are distinct in Postgres so every universal row and
  /// every row an owner left blank coexists. It is also the index the import's
  /// SKU lookup runs on.
  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, archivedAt])
  @@index([brandId])
  @@index([searchVector], type: Gin, map: "idx_catalog_fts")
  @@index([nameEn(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_catalog_trgm_en")
  @@index([nameAr(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_catalog_trgm_ar")
  @@map("catalog_products")
}

model ProductSynonym {
  id        String         @id @default(cuid())
  catalogId String
  synonym   String
  language  String         @default("en") // en | ar | hi | ur
  region    String?
  product   CatalogProduct @relation(fields: [catalogId], references: [id])

  @@index([catalogId])
  @@map("product_synonyms")
}

model CatalogCategory {
  id           String  @id @default(cuid())
  name         String
  nameAr       String?
  parentId     String?
  iconUrl      String?
  displayOrder Int     @default(0)

  @@map("catalog_categories")
}

// ─── Image assets ─────────────────────────────────────────────────────────────
//
// The grammar that separates a real offer book from a slide deck is a
// background-removed product cutout floating on a tinted panel. Open Food Facts
// and brand-portal packshots arrive on white or with a shadowed studio
// background, so removal is an ingest stage, not a shop owner's chore.
//
// Pipeline: ORIGINAL → `bg.remove` worker → CUTOUT + bboxTight. Cards always
// request CUTOUT and fall back to ORIGINAL only with a visible quality flag in
// the editor.

enum ImageKind {
  ORIGINAL
  CUTOUT
  THUMB
}

enum ReviewState {
  PENDING
  APPROVED
  REJECTED
}

model ImageAsset {
  id          String         @id @default(cuid())
  productId   String
  /// The organization that supplied this photo, when a shop contributed one to
  /// a product it does not own. Null on everything seeded, imported or
  /// generated, which is almost every row.
  ///
  /// **It is a visibility key, not just provenance.** A contributed photo sits
  /// on a *universal* product — shared by every tenant — so before review it
  /// must be visible to the shop that uploaded it and to nobody else. Without
  /// this column the choice is between showing one shop's unreviewed packshot
  /// in every other shop's books, or making the contributor wait on a reviewer
  /// to see their own flyer. `imageVisibility` in `lib/catalog.ts` is the one
  /// place that reads it.
  contributedBy String?
  kind        ImageKind
  /// The ImageAsset this was derived from. Set on CUTOUT and THUMB, null on
  /// ORIGINAL. Keeping the original is what makes a bad matte recoverable.
  derivedFrom String?
  r2Key       String
  width       Int
  height      Int
  /// The trimmed content box within the canvas, `{ x, y, w, h }` in pixels.
  /// The layout engine scales cards to optical weight, not to raw file
  /// dimensions — without this a cutout carrying 30% transparent padding
  /// renders visibly smaller than its neighbours on the same row.
  bboxTight   Json?
  /// Matting confidence, 0..1. Low scores route to review rather than shipping
  /// a haloed cutout onto a printed page.
  quality     Float?
  reviewState ReviewState    @default(PENDING)
  product     CatalogProduct @relation(fields: [productId], references: [id])
  createdAt   DateTime       @default(now())

  @@index([productId, kind])
  @@index([reviewState])
  /// Every read that filters unreviewed contributions pairs these two.
  @@index([contributedBy, reviewState])
  @@map("image_assets")
}

model ProductContribution {
  id              String          @id @default(cuid())
  /// E5-04. Shop-submitted products awaiting review for the universal catalog.
  /// The product itself is already usable in the submitting organization's own
  /// collection from the moment it is created — review decides promotion, not
  /// availability.
  shopId          String
  catalogId       String?
  imageUrl        String
  name            String
  brand           String?
  category        String?
  status          String          @default("pending") // pending | approved | rejected
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  product         CatalogProduct? @relation(fields: [catalogId], references: [id])
  createdAt       DateTime        @default(now())

  @@map("product_contributions")
}

// ─── Catalog import and capture ───────────────────────────────────────────────
//
// The owner's own list arrives as a spreadsheet, not as search queries. Import
// resolves each row against the organization's collection first, falls back to
// the universal catalog for images and details, and reports what it could not
// match. Matching by name and not only by barcode is why the tsvector migration
// blocks import as well as search.

enum ImportStatus {
  UPLOADED
  MATCHING
  REVIEW
  COMMITTED
  FAILED
}

enum ImportRowStatus {
  MATCHED
  AMBIGUOUS
  UNMATCHED
  CREATED
  SKIPPED
}

model CatalogImport {
  id             String             @id @default(cuid())
  organizationId String
  shopId         String?
  /// R2 key of the uploaded CSV or XLSX. Kept so a disputed import can be
  /// re-read rather than re-uploaded.
  sourceKey      String
  filename       String
  status         ImportStatus       @default(UPLOADED)
  /// Header name → canonical field, as the owner confirmed it on the mapping
  /// screen: `{ "Item": "nameEn", "Rate": "price" }`.
  columnMap      Json?
  rowCount       Int                @default(0)
  matchedCount   Int                @default(0)
  unmatchedCount Int                @default(0)
  /// Set when the owner commits the reviewed import into an offer book.
  committedAt    DateTime?
  error          String?
  organization   Organization       @relation(fields: [organizationId], references: [id])
  rows           CatalogImportRow[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, createdAt])
  @@map("catalog_imports")
}

model CatalogImportRow {
  id               String          @id @default(cuid())
  importId         String
  rowIndex         Int
  /// The row exactly as it was read, before any interpretation. What the
  /// "we could not match this" screen shows the owner.
  raw              Json
  status           ImportRowStatus
  /// The product this row resolved to. Null while UNMATCHED.
  catalogProductId String?
  /// Runner-up matches for an AMBIGUOUS row, ranked:
  /// `[{ catalogProductId, score }]`. The owner picks one.
  candidates       Json?
  price            Decimal?        @db.Decimal(10, 2)
  import           CatalogImport   @relation(fields: [importId], references: [id], onDelete: Cascade)
  product          CatalogProduct? @relation(fields: [catalogProductId], references: [id])

  @@unique([importId, rowIndex])
  @@index([importId, status])
  @@map("catalog_import_rows")
}

/// An offer book somebody has started and not finished. E6 —
/// `docs/E6-create-flow.md` §21.
///
/// **A draft of the *journey*, not of the book.** Creating a book writes offers
/// and, since 15 September, writes the shop's own products for rows the catalog
/// has never seen — so a book created from an unreviewed sheet is real rows an
/// owner never agreed to, and abandoning it leaves them behind. Nothing here is
/// a product, an offer or a book; it is what somebody had typed and chosen so
/// far, and it is deleted the moment the book is made.
///
/// **One JSON column rather than a modelled import.** `catalog_imports` already
/// models a sheet properly and belongs to E5-06, whose commit writes to the
/// catalog — dragging it in here is what `E6-create-flow.md` §2.3 removed on
/// purpose. What this needs is narrower and entirely private to one screen: the
/// wizard's own state, restored into the same wizard, read by nothing else. A
/// column per field would be a second model of a sheet that the server never
/// reasons about.
///
/// Bounded by `MAX_ROWS` at 200 on the routes that write it, which is what keeps
/// a JSONB value the size of a spreadsheet out of the row.
model OfferBookDraft {
  id             String @id @default(cuid())
  organizationId String
  shopId         String
  /// **Per person, not per shop.** Two staff in one shop starting different
  /// books must not overwrite each other, and a draft is somebody's unfinished
  /// work rather than the shop's.
  userId         String

  /// The wizard's state: what is being made, the sheet, the column mapping, the
  /// matches and every choice made so far. Shape owned by the client that
  /// writes it — `NewBookWizard` — and validated on the way in.
  state Json

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shop         Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  /// What "you were last here on Tuesday" reads from.
  updatedAt DateTime @updatedAt

  @@unique([shopId, userId])
  @@index([organizationId])
  @@map("offer_book_drafts")
}

model CaptureSession {
  id             String       @id @default(cuid())
  organizationId String
  shopId         String
  /// Which import or book the photographed products flow back into. Null for a
  /// standalone capture run.
  importId       String?
  /// The short code encoded into the QR the desktop shows. The phone opens
  /// `/capture/{code}` — a token-scoped surface, never the shop-owner session.
  code           String       @unique
  /// Hashed, never stored raw. Same rule as sessions.
  tokenHash      String
  expiresAt      DateTime
  revokedAt      DateTime?
  capturedCount  Int          @default(0)
  createdBy      String
  organization   Organization @relation(fields: [organizationId], references: [id])
  shop           Shop         @relation(fields: [shopId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([organizationId, expiresAt])
  @@map("capture_sessions")
}

// ─── Offer books ──────────────────────────────────────────────────────────────
//
// An offer is **N products at one price**, not one product with a price. Real
// flyers routinely put two SKUs behind one mark — "Pesto Rosso *or* Pasta Sauce
// Basilico — 1.99" — and a one-to-one product/price row cannot express it.
// Retrofitting the join after the editor exists is expensive, so it is here now.
//
// The page is composed by the layout engine from these rows plus a template.
// Fabric holds bounded per-slot adjustments, not the page. See docs/E6.

enum PriceMode {
  FIXED
  FROM
  PER_UNIT
}

enum UnitPriceMode {
  AUTO
  MANUAL
  HIDDEN
}

enum Connector {
  OR
  AND
}

enum ChipKind {
  COUNTER
  ORIGIN
  CERT
  SCALE
  LOYALTY
  CUSTOM
}

enum ChipAnchor {
  TOP_START
  TOP_END
  INLINE
}

enum FootnoteScope {
  PAGE
  BOOK
}

model OfferBook {
  id       String @id @default(cuid())
  shopId   String
  title    String
  format   String // instagram_post | story | whatsapp | leaflet | catalog | a3 | print
  status   String @default("draft") // draft | published | archived
  /// The edition language this book was authored in. The sibling edition
  /// renders from the same rows; it is a render target, not a copy.
  language String @default("en") // en | ar

  shortCode     String          @unique
  shareableLink String?
  expiresAt     DateTime?
  passwordHash  String?
  linkActive    Boolean         @default(true)
  shop          Shop            @relation(fields: [shopId], references: [id])
  /// The master grid and any cover or back page. Density is not stored: it is
  /// the consequence of track count at a given page size, and two controls that
  /// can disagree is one too many.
  grids         PageGrid[]
  pins          BookPin[]
  pages         OfferBookPage[]
  offers        Offer[]
  pageViews     PageView[]
  productClicks ProductClick[]
  exportJobs    ExportJob[]
  socialPosts   SocialPost[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([shopId, status])
  @@map("offer_books")
}

model OfferBookPage {
  id            String    @id @default(cuid())
  bookId        String
  /// Zero-based render order.
  index         Int
  /// `SlotOverride[]` keyed by `regionId` + `offerId` — see @souqstudio/types.
  /// Every entry is a bounded delta against the engine's output: offset clamped
  /// to ±8% of region width, image scale 0.8..1.25, a pinned image, text
  /// overrides.
  ///
  /// Keyed by region and offer rather than by grid position, and that is what
  /// makes a weekly reissue cheap: swap four products and every surviving card
  /// keeps its nudge. Position-derived ids could not survive a repack.
  ///
  /// This replaces the book-level `canvasState` Fabric dump. Fabric is no
  /// longer the source of truth for a page; the engine plus these deltas are.
  slotOverrides Json?
  /// `CellSpan[]` in body-card coordinates — the cells this page draws as one.
  ///
  /// **A page's layout, not the book's.** The master grid says how many cards
  /// go across and down, what the bands are and what the paper is; merging is
  /// the one layout decision an owner makes about *this page*, so it is stored
  /// against the page. Merging the first two cells of page one leaves page two
  /// alone, which is what merging on a page has to mean.
  ///
  /// **Body rows, not grid rows**: row 0 is the first row of cards whether or
  /// not a masthead sits above it. Same reasoning as the `r{row}c{col}` region
  /// ids — adding a band must not renumber every merge in the book.
  ///
  /// The flow does not restart at a merge: a page holding a merged hero holds
  /// one card fewer and the products carry on onto the next page.
  merges       Json?
  /// This page's own paper, as `{ background: PageBackground | null }`.
  ///
  /// **Three states, which is why it is wrapped.** The column being NULL means
  /// the page inherits the book's background from `page_grids.background`; a
  /// stored `{ "background": null }` means this page is deliberately plain paper
  /// even though the book has a ground; an object is that page's own.
  ///
  /// The wrapper exists because Prisma's two JSON nulls cannot be told apart on
  /// read — `DbNull` and `JsonNull` both come back as `null` — so "inherit" and
  /// "explicitly none" would be the same value. Nesting one level makes the
  /// distinction survive the round trip.
  background   Json?
  /// Blocks an owner put in particular cells of this page, as
  /// `{ [regionId]: blockId }`.
  ///
  /// **A cell holding a block that does not repeat stops taking a product**, and
  /// the products route around it exactly as they route around a pin — the offer
  /// that was there moves to the next cell and the book grows by a page rather
  /// than losing it. Whether a block repeats is read from the `blocks` row at
  /// load time rather than stored here, so a block that changes its mind is not
  /// contradicted by a stale copy.
  ///
  /// Keyed by region id — `r{row}c{col}`, the merged region's start cell — which
  /// is the same key `slotOverrides` uses and orphans the same way when the
  /// track count changes.
  regionBlocks Json?
  book          OfferBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, index])
  @@map("offer_book_pages")
}

model Offer {
  id       String @id @default(cuid())
  bookId   String
  /// Reading order within the book. The engine paginates from this; the owner
  /// changes it by dragging in the offer tray.
  position Int

  price        Decimal   @db.Decimal(10, 2)
  priceMode    PriceMode @default(FIXED)
  /// Strikethrough was-price. Null when there is nothing to compare against.
  comparePrice Decimal?  @db.Decimal(10, 2)
  currency     String    @default("AED") // AED | SAR | QAR | KWD | OMR | BHD
  promoTierId  String

  /// AUTO derives `(1 kg = 1.76)` from pack maths, MANUAL takes `unitPriceValue`,
  /// HIDDEN suppresses the line. Not legally required in the GCC, but it costs
  /// nothing and reads as credible, so it defaults on.
  unitPriceMode  UnitPriceMode @default(AUTO)
  /// Frozen at publish so a reprint of an old book reproduces exactly, rather
  /// than recomputing against pack data that has since been corrected.
  unitPriceValue Decimal?      @db.Decimal(10, 3)
  unitPriceUnit  PackUnit?

  /// Deposit lines, service fees — rendered under the card, not as footnotes.
  legalLines String[]

  book      OfferBook           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  promoTier PromoTier           @relation(fields: [promoTierId], references: [id])
  items     OfferItem[]
  chips     OfferChip[]
  footnotes OfferFootnote[]
  overrides OfferShopOverride[]
  clicks    ProductClick[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([bookId, position])
  @@index([bookId])
  @@map("offers")
}

model OfferItem {
  id               String     @id @default(cuid())
  offerId          String
  catalogProductId String
  /// Render and read order within the offer. Item 0 supplies the brand lockup
  /// and the primary image; later items render their name/spec block prefixed
  /// by the localised connector.
  position         Int
  /// Rendered between this item and the one before it. Null on item 0.
  connector        Connector?

  /// Per-book corrections that must not write back to the catalog. A shop
  /// renaming a product for one flyer is not a catalog edit.
  nameOverrideEn String?
  nameOverrideAr String?
  specOverrideEn String?
  specOverrideAr String?
  /// A pinned image variant. Null uses the product's default CUTOUT.
  imageAssetId   String?

  offer   Offer          @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product CatalogProduct @relation(fields: [catalogProductId], references: [id])

  @@unique([offerId, position])
  @@index([catalogProductId])
  @@map("offer_items")
}

model PromoTier {
  id             String  @id @default(cuid())
  organizationId String
  labelEn        String // "Deal", "Super Saver"
  labelAr        String?
  /// A design-system colour token name, never a raw hex. Same enforcement rule
  /// as the rest of the system — see CLAUDE.md.
  tokenRef       String
  /// 1..3. Drives badge scale in the layout engine, and which offers bid first
  /// for spanning slots.
  emphasis       Int     @default(1)
  isDefault      Boolean @default(false)

  organization Organization @relation(fields: [organizationId], references: [id])
  offers       Offer[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([organizationId])
  @@map("promo_tiers")
}

model OfferChip {
  id      String     @id @default(cuid())
  offerId String
  kind    ChipKind
  labelEn String
  labelAr String?
  /// Kind-specific payload: `{ "scale": 3, "of": 5 }` for SCALE,
  /// `{ "amount": 0.20 }` for LOYALTY.
  value   Json?
  /// Logical, not physical — TOP_START lands on the correct corner in an AR
  /// edition without a second rule. Anchored chips may overhang the card by up
  /// to half their own width, which is why card groups render unclipped.
  anchor  ChipAnchor @default(TOP_START)
  offer   Offer      @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@map("offer_chips")
}

model OfferFootnote {
  id      String        @id @default(cuid())
  offerId String
  textEn  String
  textAr  String?
  scope   FootnoteScope @default(PAGE)
  /// No marker number here on purpose. Numbering is assigned at render time in
  /// reading order, so an AR edition numbers right-to-left correctly from the
  /// same rows. Storing it would give two answers that can disagree.
  offer   Offer         @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@map("offer_footnotes")
}

model OfferShopOverride {
  offerId     String
  shopId      String
  /// Null keeps the offer's own price. Resolution is override → offer default.
  price       Decimal? @db.Decimal(10, 2)
  /// False removes the offer from that shop's edition entirely. The layout
  /// engine reflows the page rather than leaving a hole.
  isAvailable Boolean  @default(true)
  offer       Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([offerId, shopId])
  @@index([shopId])
  @@map("offer_shop_overrides")
}

// ─── Templates & Grids ───────────────────────────────────────────────────────
/// A designed building block — the unit an offer book is assembled from.
///
/// Lego, not a page. A block is one repeatable thing: an offer card, a header, a
/// hero band, a footer. It knows its own interior and nothing about where it
/// sits; the page grid decides that. See `docs/composition-model.md` §3.
///
/// This replaced `templates`, which described a whole page. A brand kit carries
/// no layout any more and a book picks its own grid, so a template that bundled
/// look *and* arrangement had nothing left to be.
model Block {
  id             String  @id @default(cuid())
  /// Null for the blocks SouqStudio seeds. Set for ones an owner authored —
  /// which is what makes a saved block the asset that compounds.
  organizationId String?
  name           String
  description    String?

  /// Does this block repeat over the product list, or is it placed once?
  ///
  /// The one distinction that matters, and it decides the binding vocabulary: a
  /// repeating block offers product fields because it renders once per offer
  /// and knows which one. A static block has no product in scope, so those
  /// fields do not exist for it rather than merely being empty.
  repeats Boolean @default(true)

  /// `Arrangement[]` from @souqstudio/types — one layout per aspect range, so a
  /// merged region reflows rather than stretching. Every colour inside is a
  /// TokenRef and every size a multiple of the type scale; never a hex, never a
  /// pixel.
  arrangements Json

  thumbnailUrl String?
  status       String         @default("draft") // draft | published | archived
  planTier     String         @default("starter")

  /// Which group of the shipped library this block is — `offer-card`, `header`,
  /// `panel`, `footer`, `seasonal`. Null on a block an owner authored, and it
  /// needs none: the picker lists theirs first and separately, because that is
  /// the collection they can change.
  ///
  /// **It is a column because the app can no longer ask the library.** The
  /// category was derived in code from the block's id, which worked while
  /// `SEED_BLOCKS` was a TypeScript constant the web app could import — and
  /// cost 72 KB of client bundle to do it, since the picker that needed the
  /// answer runs in a browser. The library is a loaded document now
  /// (`library-source.ts`), and may one day be loaded from somewhere that is
  /// not the repo at all, so the row is the only place the answer can live.
  ///
  /// Only the seed ever writes it, which is the objection that kept it out of
  /// the schema for a week — and is exactly what a seed is for. Same argument
  /// that put `occasion` below it a day earlier.
  category     String?

  isSeasonal   Boolean        @default(false)
  /// Which occasion, for a block whose window is computed rather than stored —
  /// `ramadan`, `eid-al-fitr`, `national-day`. See `packages/engine/src/seasonal.ts`.
  ///
  /// **It is a column because an import makes a copy with a new id.** The seeded
  /// library maps id → occasion in code, which works right up until an owner
  /// imports the Ramadan band and the copy is a cuid that map has never heard
  /// of. Carrying the occasion on the row is what keeps the copy correct — and
  /// correct *next year too*, because the window is still derived rather than
  /// frozen into `activeFrom`.
  occasion     String?
  /// A window the owner set by hand, for a block only they could schedule — a
  /// shop's own anniversary. Null on every seeded block, deliberately: Ramadan
  /// and both Eids move against the Gregorian calendar, so a stored date is
  /// wrong from its second year.
  activeFrom   DateTime?
  activeTo     DateTime?
  organization Organization?  @relation(fields: [organizationId], references: [id])
  versions     BlockVersion[]
  pins         BookPin[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([organizationId, status])
  @@map("blocks")
}

/// Artwork a shop uploaded, and the motifs SouqStudio ships. E7-C.
///
/// **The row is a record, not an address.** `ImageSource.assetId` in a block
/// document holds the R2 object key and always will: `assetResolver` turns that
/// key straight into a URL with no query, which is what keeps a block document
/// portable and keeps Prisma out of the render path. Pointing a document at this
/// table's `id` instead would put a lookup inside every draw.
///
/// So `key` is unique and is the join. What the table adds is everything a *key*
/// cannot answer — what the file is called, how big it is, who owns it, and
/// above all **what artwork exists**. Without it there is no listing, so there is
/// no reuse: an owner who uploads a badge for one block re-uploads it for the
/// next, and every use leaves another object nothing references.
///
/// `organizationId` null is the overlay library — crescents, lanterns, National
/// Day motifs — on the same seeded/authored split `blocks` already uses, so one
/// picker shows both and neither is a special case.
model BlockAsset {
  id             String  @id @default(cuid())
  /// Null for the motifs we ship. Set for artwork an owner uploaded.
  organizationId String?
  /// The R2 object key. What a block document stores, and the join to it.
  key            String  @unique
  /// What the owner sees in the picker. Their filename, less the extension.
  name           String
  /// Of the stored PNG. A picker draws each asset at its own proportion, and a
  /// grid of squares would lie about what a wide banner is.
  width          Int
  height         Int
  bytes          Int
  /// Only the seeded motifs carry one — `ramadan`, `national-day`. An owner's
  /// own artwork has no category and needs none, exactly as their blocks do not.
  category       String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@map("block_assets")
}

model BlockVersion {
  id           String   @id @default(cuid())
  blockId      String
  arrangements Json
  block        Block    @relation(fields: [blockId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([blockId])
  @@map("block_versions")
}

/// A page as a spreadsheet: fr tracks, merged regions, one block per region.
///
/// `role` is what makes a weekly reissue cheap. Body pages are instances of the
/// `master` — edit it once and every page follows — while `cover` and `back` are
/// authored individually and never repeat.
model PageGrid {
  id     String @id @default(cuid())
  bookId String
  /// master | cover | back
  role   String @default("master")

  /// Column track sizes in fr, in reading order. `Float[]`, not a grid preset:
  /// tracks are draggable, exactly like column widths in a spreadsheet.
  cols   Float[]
  /// Row track sizes, top to bottom. Rows never mirror.
  rows   Float[]
  /// Gap between tracks, as a fraction of the shorter page edge.
  gap    Float   @default(0.02)
  /// Inset on all four sides, same units. Zero is full bleed — right for a
  /// social post, wrong for anything a guillotine touches.
  margin Float   @default(0)

  /// `PageBackground` from @souqstudio/types: the paper behind every card.
  /// Flat colour, gradient or uploaded artwork. Null is `--sq-tpl-paper`, which
  /// is what every book drew before the column existed — so null is the honest
  /// default and no backfill is owed.
  background Json?

  /// `Region[]` from @souqstudio/types. Coordinates are logical and inclusive,
  /// so an AR edition mirrors the whole grid — merges included — with no second
  /// layout to author.
  regions Json

  book OfferBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  // No relation to `blocks`. A region names its block by id *inside* the
  // `regions` JSON, and Prisma cannot enforce a foreign key through JSON — a
  // relation here would only create a join table nothing ever writes to. The
  // engine resolves block ids when it loads a book; that is the seam.

  @@index([bookId])
  @@map("page_grids")
}

/// A static block parked at a position in the flow. Products route around it.
///
/// A pin targets a *position*, not a card — which is the entire point. A
/// replacement targets a card, and next week that card holds a different
/// product, so the edit is meaningless or lost. With fifteen more products next
/// week the brand ad is still on page 2 in the same two cells.
///
/// Displacement grows the book; it never consumes the product that would have
/// sat there. Silently dropping a product is the class of bug that reaches
/// print.
model BookPin {
  id        String @id @default(cuid())
  bookId    String
  /// Zero-based. Absolute for now; anchoring to a category boundary is v2 and
  /// the schema must not foreclose it.
  pageIndex Int
  blockId   String

  /// Logical and inclusive, same convention as a Region.
  colStart Int
  colEnd   Int
  rowStart Int
  rowEnd   Int

  /// Static content for this pin — headline, image, whatever its block binds.
  content Json?

  book  OfferBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  block Block     @relation(fields: [blockId], references: [id])

  @@index([bookId, pageIndex])
  @@map("book_pins")
}

// ─── AI & Characters ─────────────────────────────────────────────────────────
model Character {
  id                 String          @id @default(cuid())
  shopId             String
  baseImageUrl       String
  style              String // cartoon | semi-realistic | flat | mascot
  nationality        String
  gender             String
  /// Extracted uniform details (color, type, logo position)
  uniformDescription Json?
  shop               Shop            @relation(fields: [shopId], references: [id])
  poses              CharacterPose[]
  createdAt          DateTime        @default(now())

  @@map("characters")
}

/// One thing a cover can be *of*, as a row rather than as a constant. E8-04.
///
/// **In the database because the art direction is the product here.** These
/// started as a TypeScript map and were wrong twice in a day — first a set of
/// adjectives that produced generic wallpaper, then a set of nouns that got
/// worn by the shop assistant. Both fixes needed a deploy. A prompt that is
/// tuned by looking at what came back is content, and content that needs a
/// release to change is content nobody tunes.
///
/// **`scene` is art direction, not a theme.** The thing that made covers look
/// stock was describing an *occasion* — "a weekend sale, energetic" — rather
/// than a photograph somebody took: the assistant with a microphone by a stacked
/// display, the assistant in the vegetable aisle with a crate of tomatoes. A
/// scene has a place, a person doing something, and a light. An occasion has
/// none of those, so the model averages every image ever labelled with it.
///
/// **Global only, for now.** `organizationId` is absent deliberately: these are
/// ours to write and tune, and a shop that wants something else has the
/// free-text option the picker already offers. A per-shop library is a different
/// feature and would want a different table shape.
model CoverPrompt {
  id   String @id @default(cuid())
  /// Stable across edits, and what the client names. The id an owner's picker
  /// sends; the text it resolves to is read here and never trusted from them.
  slug String @unique

  /// What the picker calls it. Sentence case, per the design system.
  label String
  /// One line under the label, so an owner can tell two shelf scenes apart.
  hint  String?

  /// The art direction itself — the paragraph that reaches the image model.
  ///
  /// **Written as a photograph of this shop.** It says where the person is,
  /// what they are doing and what the light is like. It never says what they
  /// wear: `coverPrompt` owns that, because the uniform comes from the
  /// character reference and a scene that dresses them fights it.
  scene String

  /// Who this scene wants in it — `staff`, `customer` or `none`.
  ///
  /// **A scene knows this and an owner does not have to.** A staff member
  /// pushing a full trolley of shopping is not a picture of anything; a customer
  /// doing it is the commonest retail cover there is. Equally, nobody but staff
  /// stands behind the meat counter. So the row carries what it suits and the
  /// picker follows it, while still letting an owner say otherwise.
  ///
  /// `staff` is the only one that consumes the shop's character reference.
  /// `customer` is invented by the model, which is the point — a shop has one
  /// mascot and many customers, and a customer who looked the same on every
  /// cover would read as an employee.
  person String @default("staff")

  /// Rough grouping for the picker — `everyday`, `season`, `occasion`. A string
  /// rather than an enum because the groups are a presentation judgement that
  /// will move, and a row naming a group we dropped should still render.
  group String @default("everyday")

  /// Off rather than deleted. A prompt that produced bad covers is worth keeping
  /// to compare against the one that replaced it, and a `covers` row may name it.
  isActive Boolean @default(true)
  /// Ascending. Ties break on `label`.
  sortOrder Int    @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("cover_prompts")
}

/// A cover an owner generated and kept. E8-04.
///
/// **A brand asset, not a property of one book.** It was a page background in
/// the editor first, which made a cover something you made inside one book and
/// could never reuse — so the same shop paid five credits again the next week
/// for the same Ramadan cover. It is made once on `/brand` and picked from
/// there, like a character.
///
/// **Shop-scoped, with no `organizationId`** — the same shape `characters` has,
/// and the same consequence: every query goes by `shopId` from the active shop
/// and the usual organization guard does not appear. `E8-pending.md` §3a item 3
/// carries that note and it applies here unchanged.
model Cover {
  id     String @id @default(cuid())
  shopId String

  /// The R2 object key, never a URL — the same rule `image_assets` and
  /// `product_brands.logoKey` follow, so this survives the bucket moving behind
  /// a different public origin.
  r2Key  String

  /// What it was generated from, kept so the library can label itself and an
  /// owner can tell two Ramadan covers apart. Strings rather than enums: they
  /// are `CAMPAIGNS` and `COVER_STYLES` in the engine, which move with product
  /// judgement, and a stored row naming a campaign we no longer offer should
  /// still render rather than fail to read.
  campaign String
  style    String
  /// One of `COVER_SHAPES`. Which page proportions it was drawn for — a story
  /// cover on an A4 page is cropped to a sliver, so the picker warns.
  shape    String

  shop      Shop     @relation(fields: [shopId], references: [id])
  createdAt DateTime @default(now())

  @@index([shopId, createdAt])
  @@map("covers")
}

model CharacterPose {
  id          String    @id @default(cuid())
  characterId String
  poseType    String // waving | holding | announcing | thumbs-up | celebrating | speech | running | custom
  imageUrl    String
  customLabel String?
  character   Character @relation(fields: [characterId], references: [id])
  createdAt   DateTime  @default(now())

  @@map("character_poses")
}

model AiJob {
  id             String       @id @default(cuid())
  organizationId String
  shopId         String?
  type           String // character_gen | pose_gen | cover_gen | background_removal | prompt_gen
  status         String       @default("queued") // queued | processing | complete | failed
  /// Result payload (image URLs, etc.)
  result         Json?
  errorMessage   String?
  creditsCost    Int
  /// When the owner took what this produced — chose a character, kept a logo
  /// mark, accepted a palette. E8.
  ///
  /// **A job can be `complete` and still owe somebody something.** Character and
  /// logo generation both return several options and charge for the set; the
  /// artefact only exists once a person has picked one. Until this was here the
  /// only thing that could reach a finished job was the browser tab that started
  /// it — close it mid-generation and the credits were spent, the images were in
  /// R2, and nothing in the product could find them again.
  ///
  /// Null on a job that produces its artefact directly, like magic block, which
  /// writes a draft block and has nothing left to claim. Those are excluded by
  /// type rather than by leaving this set.
  claimedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  completedAt    DateTime?

  /// The unfinished-work query: this organization's jobs, newest first.
  @@index([organizationId, status, createdAt])

  @@map("ai_jobs")
}

model UsageEvent {
  id             String       @id @default(cuid())
  organizationId String
  shopId         String?
  eventType      String // character_gen | pose_gen | cover_gen | background_removal | prompt_gen
  creditsUsed    Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())

  /// Both indexes are period queries: the billing screen sums the organization
  /// over the current cycle, and allocated pooling (E3-03) sums one shop over
  /// the same window on the path of every AI action.
  @@index([organizationId, createdAt])
  @@index([shopId, createdAt])
  @@map("usage_events")
}

// ─── Export jobs ──────────────────────────────────────────────────────────────
model ExportJob {
  id           String    @id @default(cuid())
  offerBookId  String
  format       String
  status       String    @default("queued") // queued | processing | complete | failed
  fileUrl      String?
  printReady   Boolean   @default(false)
  errorMessage String?
  offerBook    OfferBook @relation(fields: [offerBookId], references: [id])
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@map("export_jobs")
}

// ─── Analytics ────────────────────────────────────────────────────────────────
model PageView {
  id          String    @id @default(cuid())
  offerBookId String
  sessionId   String
  pageNumber  Int       @default(1)
  source      String? // whatsapp | instagram | direct | other
  device      String? // mobile | tablet | desktop
  durationSec Int?
  offerBook   OfferBook @relation(fields: [offerBookId], references: [id])
  createdAt   DateTime  @default(now())

  @@map("page_views")
}

model ProductClick {
  id          String    @id @default(cuid())
  offerBookId String
  /// The card that was clicked. An offer may carry several products behind one
  /// price, so the click belongs to the offer; `catalogId` records which item
  /// within it, when the viewer surface can tell.
  offerId     String?
  catalogId   String?
  sessionId   String
  pageNumber  Int       @default(1)
  offerBook   OfferBook @relation(fields: [offerBookId], references: [id])
  offer       Offer?    @relation(fields: [offerId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([offerBookId, createdAt])
  @@map("product_clicks")
}

// ─── Social publishing ───────────────────────────────────────────────────────
model SocialConnection {
  id          String    @id @default(cuid())
  shopId      String
  platform    String // instagram | facebook
  /// AES-256 encrypted access token
  accessToken String
  pageId      String?
  accountName String?
  shop        Shop      @relation(fields: [shopId], references: [id])
  connectedAt DateTime  @default(now())
  expiresAt   DateTime?

  @@map("social_connections")
}

model SocialPost {
  id             String    @id @default(cuid())
  offerBookId    String
  shopId         String
  platform       String // instagram | facebook
  status         String    @default("draft") // draft | scheduled | published | failed
  scheduledAt    DateTime?
  publishedAt    DateTime?
  externalPostId String?
  caption        String?
  errorMessage   String?
  offerBook      OfferBook @relation(fields: [offerBookId], references: [id])
  createdAt      DateTime  @default(now())

  @@map("social_posts")
}

// ─── Notifications ────────────────────────────────────────────────────────────
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())

  @@map("notifications")
}

model NotificationPreference {
  id               String  @id @default(cuid())
  userId           String
  channel          String // email | whatsapp | in_app
  notificationType String
  enabled          Boolean @default(true)
  user             User    @relation(fields: [userId], references: [id])

  @@unique([userId, channel, notificationType])
  @@map("notification_preferences")
}

// ─── Admin ────────────────────────────────────────────────────────────────────
model AdminUser {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  role         String // super_admin | catalog_manager | support_agent
  lastLoginAt  DateTime?
  auditLogs    AdminAuditLog[]
  createdAt    DateTime        @default(now())

  @@map("admin_users")
}

model AdminAuditLog {
  id          String    @id @default(cuid())
  adminUserId String
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])
  createdAt   DateTime  @default(now())

  @@map("admin_audit_logs")
}
