{
  "extends": "@souqstudio/config/tsconfig.nextjs.json",
  "compilerOptions": {
    // The shared config declares paths; without a local baseUrl they resolve
    // relative to packages/config instead of this app.
    "baseUrl": ".",
    "allowJs": true,
    "noEmit": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
