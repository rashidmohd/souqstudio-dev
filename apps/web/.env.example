# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — optional. Absent means the Google button does not render.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# Authorised redirect URI: http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=souqstudio
R2_PUBLIC_URL=https://assets.souqstudio.com
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# Redis (Upstash)
REDIS_URL=rediss://

# Email (Resend)
RESEND_API_KEY=re_
EMAIL_FROM=SouqStudio <send@updates.souqstudio.com>

# AI
OPENAI_API_KEY=sk-
ANTHROPIC_API_KEY=sk-ant-

# Background removal microservice
REMBG_SERVICE_URL=http://localhost:8000

# Magic block (E8-07) — which model reads a picture of a card.
# Unset means Claude, which is the path known to work. Setting it to `qwen`
# requires DASHSCOPE_API_KEY or the worker refuses to boot.
# MAGIC_BLOCK_PROVIDER=qwen
# DASHSCOPE_API_KEY=
# Beijing accounts need https://dashscope.aliyuncs.com/compatible-mode/v1 —
# an account is not authorised on the other region and the 401 looks like a bad key.
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_VISION_MODEL=qwen-vl-max

# Google Fonts — the Web Fonts Developer API key.
# Optional. Unset, the font picker shows only what is already mirrored into the
# `fonts` table; set, it shows the library filtered to the shop's languages.
# Create one in Google Cloud console and enable "Web Fonts Developer API" on it.
# docs/fonts-from-google.md
GOOGLE_FONTS_API_KEY=

# Generative fill: credits charged per fill in the block designer.
# Optional. Unset is 1; 0 makes it free. The worker charges what the job records.
# GENERATIVE_FILL_CREDITS=1
