DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
ADMIN_SESSION_SECRET=generate-with-openssl-rand-base64-32
# Comma separated addresses or IPv4 CIDR blocks. **Empty allows every address.**
#
# Leave it empty until you know what to put in it. A non-empty list that does
# not contain your own public address makes every page answer 404, including the
# login screen, and the refusal is deliberately indistinguishable from a missing
# route. The server log says which address was refused; the browser never will.
#
# 127.0.0.1 is only ever right for a local `next start`. It is wrong on Railway,
# where the address that arrives is the public one your browser came from.
ADMIN_IP_ALLOWLIST=
R2_PUBLIC_URL=https://assets.souqstudio.com
REDIS_URL=rediss://

# Block library console. Both or neither: without them the blocks screen is
# read-only and says so. The token must match apps/web's LIBRARY_PUBLISH_TOKEN.
WEB_APP_URL=http://localhost:3000
LIBRARY_PUBLISH_TOKEN=
