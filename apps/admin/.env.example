DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
ADMIN_SESSION_SECRET=generate-with-openssl-rand-base64-32
# Comma separated. Empty means every address is allowed, which is only correct
# in development. Production must list the office and VPN ranges.
ADMIN_IP_ALLOWLIST=127.0.0.1,::1
R2_PUBLIC_URL=https://assets.souqstudio.com
REDIS_URL=rediss://

# Block library console. Both or neither: without them the blocks screen is
# read-only and says so. The token must match apps/web's LIBRARY_PUBLISH_TOKEN.
WEB_APP_URL=http://localhost:3000
LIBRARY_PUBLISH_TOKEN=
